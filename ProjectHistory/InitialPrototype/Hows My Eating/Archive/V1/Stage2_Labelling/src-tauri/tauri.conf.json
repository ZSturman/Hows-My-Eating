{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stage2-test",
  "version": "0.1.0",
  "identifier": "com.stage2-test.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "stage2-test",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**/*"]
      },
      "csp": {
        "defaultSrc": "'self'",
        "scriptSrc": "'self' 'unsafe-eval'",
        "styleSrc": "'self' 'unsafe-inline'",
        "fontSrc": "'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "connectSrc": "'self'",
        "frameSrc": "'self'"
      }
    }
  },
  "bundle": {
    "externalBin": ["binaries/collect-mov-info", "binaries/compute-ratios", "binaries/process-visuals", "binaries/merge", "binaries/chunks", "binaries/exporting", "binaries/not_chew"],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
